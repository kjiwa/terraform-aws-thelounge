# Single rightsize tick: replace the instance if a cheaper eligible Spot pool
# is available. Driven by
# thelounge-rightsize-watchdog.timer; installed and enabled by user_data on
# first boot, kept current thereafter by thelounge-converge.sh.
[Unit]
Description=thelounge scale-back to the cheapest eligible Spot pool
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/thelounge-rightsize-watchdog
