# user_data starts the first converge itself once instance.env exists; this
# timer's first tick is a fallback 5 minutes after it starts, and it repeats
# every 5 minutes after each run -- frequent enough that a fresh build or a
# config change reaches a running instance quickly, without a no-op tick (a
# handful of S3 HEAD/GET calls) costing anything worth avoiding. No
# Persistent=: the instance is always on, and a missed tick is caught by the
# next one.
[Unit]
Description=Run thelounge converge

[Timer]
OnActiveSec=5min
OnUnitActiveSec=5min
AccuracySec=15

[Install]
WantedBy=timers.target
